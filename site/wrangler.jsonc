// reha.stream: the site's built files, served by Cloudflare as they are,
// with _redirects and _headers from the build (site/cloudflare/). No code
// runs. Only site.yml's site · deploy puts this Worker up, from main; it
// then answers at reha.stream and nowhere else.
//
// Addresses: /stories serves stories.html; /stories/ and /stories.html
// send the visitor to /stories (html_handling). An address that is no file
// gets 404.html with status 404.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reha-stream",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "reha.stream", "custom_domain": true }]
}
