{
  "version": 3,
  "routes": [
    {
      "src": "^/mac/?$",
      "status": 307,
      "headers": {
        "Location": "https://github.com/voronizer/rehearsal-recorder/releases/latest/download/RehearsalRecorder-macos.zip"
      }
    },
    {
      "src": "^/windows/?$",
      "status": 307,
      "headers": {
        "Location": "https://github.com/voronizer/rehearsal-recorder/releases/latest/download/RehearsalRecorder-windows.zip"
      }
    },
    {
      "src": "^/assets/.+$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    }
  ]
}
