<?xml version="1.0" encoding="utf-8"?>
<!--
  .NET Framework's settings for Reha.exe, which the build puts beside it
  (rehearsal-recorder.spec). The app writes nothing in .NET, but pywebview
  draws its window on Windows with WinForms, which is .NET, reached through
  pythonnet.

  A zip a browser downloads carries a "from the internet" mark, and Explorer
  passes it on to every file it unpacks from it. .NET then refuses to load
  Python.Runtime.dll and the window's other libraries, and the app stops at
  start with "Failed to resolve Python.Runtime.Loader.Initialize". Unblock in
  the zip's Properties clears the mark; this setting lets .NET load them
  with it. It is Microsoft's own for an app copied from the web:
  https://learn.microsoft.com/en-us/dotnet/framework/configure-apps/file-schema/runtime/loadfromremotesources-element

  release.yml marks the build this way before its self-test, which loads the
  window's libraries, so a build without this file is never released.
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
