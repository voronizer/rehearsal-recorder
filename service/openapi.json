{
  "openapi": "3.1.0",
  "info": {
    "title": "The band service",
    "version": "1"
  },
  "components": {
    "securitySchemes": {
      "rehaKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "The secret part of the key, after the last “:”"
      }
    },
    "schemas": {
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "owner"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Ok": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "ok"
        ]
      },
      "Member": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          },
          "signed_in": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "confirmed",
          "signed_in"
        ]
      },
      "Key": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "created_at"
        ]
      },
      "TakeMeta": {
        "type": "object",
        "properties": {
          "rehearsal": {
            "type": "object",
            "properties": {
              "uid": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date"
              }
            },
            "required": [
              "uid",
              "name",
              "date"
            ]
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "song": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "duration_sec": {
            "type": "number",
            "minimum": 0
          },
          "gen": {
            "type": "integer",
            "minimum": 1
          },
          "cut_start": {
            "type": "number",
            "minimum": 0
          },
          "starred": {
            "type": "boolean"
          },
          "balance": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "tracks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                },
                "icon": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "position",
                "name",
                "icon",
                "files"
              ]
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                }
              },
              "required": [
                "position",
                "name",
                "file"
              ]
            }
          },
          "marks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "number",
                  "minimum": 0
                },
                "label": {
                  "type": "string"
                },
                "colour": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "at",
                "label",
                "colour",
                "note"
              ]
            }
          }
        },
        "required": [
          "rehearsal",
          "number",
          "name",
          "song",
          "duration_sec",
          "gen",
          "cut_start",
          "starred",
          "balance",
          "tracks",
          "notes",
          "marks"
        ]
      },
      "Gone": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "gone": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/me": {
      "get": {
        "responses": {
          "200": {
            "description": "Done",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the key does not work",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Done",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "400": {
            "description": "Not as the service expects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the key does not work",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
